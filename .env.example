# Δημόσιμες τιμές που βρίσκονται στο Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Set to false when the teacher closes team submissions.
VITE_REGISTRATION_OPEN=true

# Το GitHub Actions συμπληρώνει αυτόματα τη σωστή τιμή κατά την ανάπτυξη.
# VITE_BASE_PATH=/REPOSITORY_NAME/
